# Copie para .env (local) ou cadastre como variáveis no Railway.
DEBUG=0
SECRET_KEY=troque-por-uma-frase-longa-e-aleatoria
ALLOWED_HOSTS=app.suaagencia.com.br,.up.railway.app
CSRF_TRUSTED_ORIGINS=https://app.suaagencia.com.br,https://*.up.railway.app
# Usuário de banco SEM superusuário (ver docs/COMO_RODAR_E_PUBLICAR.md, parte B)
DATABASE_URL=postgresql://hera_app:SENHA@HOST:PORTA/railway
# E-mail: o app não envia e-mails (o criador entra com o código de acesso enviado no grupo e cria a senha).
# Não é preciso cadastrar nenhuma variável EMAIL_*.
